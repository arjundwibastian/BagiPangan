# Version control
.git
.gitignore

# Environment files and secrets (never send these into the build context)
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
zero-hunger-infra/certs/
frontend/node_modules/
frontend/dist/

# OS / editor junk
**/.DS_Store
**/.vscode

# Build artifacts
**/*.exe
**/*.test
**/bin/
**/coverage.out

# Docs and assets not needed inside images
**/*.md
project-flow.webp
