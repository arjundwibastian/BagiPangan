{
  "info": { "name": "Zero Hunger - Local E2E", "description": "Run in order with the Zero Hunger Local environment.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
    "if (!pm.environment.get('run_suffix') || pm.environment.get('run_suffix') === 'local') pm.environment.set('run_suffix', Date.now().toString());",
    "pm.environment.set('available_from', new Date(Date.now() - 60000).toISOString());",
    "pm.environment.set('available_until', new Date(Date.now() + 86400000).toISOString());"
  ] } }],
  "item": [
    { "name": "1. Register donor", "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json(); pm.test('HTTP 201',()=>pm.expect(pm.response.code).to.eql(201)); pm.test('code 00',()=>pm.expect(b.rc).to.eql('00')); pm.environment.set('donor_id',b.data.user_id);"] } }], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"name\":\"E2E Donor\",\"email\":\"e2e.donor.{{run_suffix}}@example.com\",\"phone\":\"081234567890\",\"password\":\"password123\",\"role\":\"donor\"}"}, "url":"{{user_base_url}}/api/v1/auth/register" } },
    { "name": "2. Register recipient", "event": [{ "listen": "test", "script": { "exec": ["const b=pm.response.json(); pm.test('HTTP 201',()=>pm.expect(pm.response.code).to.eql(201)); pm.test('code 00',()=>pm.expect(b.rc).to.eql('00')); pm.environment.set('recipient_id',b.data.user_id);"] } }], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"name\":\"E2E Recipient\",\"email\":\"e2e.recipient.{{run_suffix}}@example.com\",\"phone\":\"081234567891\",\"password\":\"password123\",\"role\":\"recipient\"}"}, "url":"{{user_base_url}}/api/v1/auth/register" } },
    { "name": "3. Login donor", "event": [{ "listen":"test", "script": {"exec":["const b=pm.response.json(); pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.eql(200)); pm.test('code 00',()=>pm.expect(b.rc).to.eql('00')); pm.environment.set('donor_token',b.data.access_token); pm.environment.set('donor_id',b.data.user.user_id);"]}}], "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"e2e.donor.{{run_suffix}}@example.com\",\"password\":\"password123\"}"},"url":"{{user_base_url}}/api/v1/auth/login"} },
    { "name": "4. Login recipient", "event": [{ "listen":"test", "script": {"exec":["const b=pm.response.json(); pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.eql(200)); pm.test('code 00',()=>pm.expect(b.rc).to.eql('00')); pm.environment.set('recipient_token',b.data.access_token); pm.environment.set('recipient_id',b.data.user.user_id);"]}}], "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"e2e.recipient.{{run_suffix}}@example.com\",\"password\":\"password123\"}"},"url":"{{user_base_url}}/api/v1/auth/login"} },
    { "name": "5. Donor creates food listing", "event": [{"listen":"test","script":{"exec":["const b=pm.response.json(); pm.test('HTTP 201',()=>pm.expect(pm.response.code).to.eql(201)); pm.test('code 00',()=>pm.expect(b.responseCode).to.eql('00')); pm.environment.set('food_listing_id',b.responseData.food_listing_id);"]}}], "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{donor_token}}"}],"body":{"mode":"raw","raw":"{\"title\":\"E2E prepared meals\",\"description\":\"Food for E2E\",\"latitude\":-6.2,\"longitude\":106.816666,\"food_type\":\"cooked_food\",\"quantity\":10,\"available_from\":\"{{available_from}}\",\"available_until\":\"{{available_until}}\"}"},"url":"{{food_base_url}}/api/v1/food-listings"} },
    { "name": "6. Recipient creates food request", "event": [{"listen":"test","script":{"exec":["const b=pm.response.json(); pm.test('HTTP 201',()=>pm.expect(pm.response.code).to.eql(201)); pm.test('code 00',()=>pm.expect(b.rc).to.eql('00')); pm.expect(b.data.request.status).to.eql('searching'); pm.environment.set('request_id',b.data.request.request_id);"]}}], "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{recipient_token}}"}],"body":{"mode":"raw","raw":"{\"latitude\":-6.2,\"longitude\":106.816666,\"radius_km\":5}"},"url":"{{request_base_url}}/api/v1/food-requests"} },
    { "name": "7. Recipient searches nearby", "event": [{"listen":"test","script":{"exec":["const b=pm.response.json(); pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.eql(200)); pm.test('code 00',()=>pm.expect(b.responseCode).to.eql('00')); pm.expect(b.responseData).to.be.an('array').that.is.not.empty; pm.environment.set('food_listing_id',b.responseData[0].food_listing_id);"]}}], "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{recipient_token}}"}],"url":"{{food_base_url}}/api/v1/food-listings/nearby?request_id={{request_id}}"} },
    { "name": "8. Recipient creates claim", "event": [{"listen":"test","script":{"exec":["const b=pm.response.json(); pm.test('HTTP 201',()=>pm.expect(pm.response.code).to.eql(201)); pm.test('code 00',()=>pm.expect(b.responseCode).to.eql('00')); pm.expect(b.responseData.status).to.eql('waiting_for_pickup'); pm.environment.set('claim_id',b.responseData.claim_id); pm.environment.set('claim_code',b.responseData.claim_code);"]}}], "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{recipient_token}}"}],"body":{"mode":"raw","raw":"{\"request_id\":\"{{request_id}}\",\"food_listing_id\":\"{{food_listing_id}}\",\"claimed_quantity\":2}"},"url":"{{claim_base_url}}/api/v1/claims"} },
    { "name": "9. Recipient gets claim detail", "event": [{"listen":"test","script":{"exec":["const b=pm.response.json(); pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.eql(200)); pm.test('code 00',()=>pm.expect(b.responseCode).to.eql('00')); pm.expect(b.responseData.status).to.eql('waiting_for_pickup');"]}}], "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{recipient_token}}"}],"url":"{{claim_base_url}}/api/v1/claims/{{claim_id}}"} },
    { "name": "10. Donor verifies pickup code", "event": [{"listen":"test","script":{"exec":["const b=pm.response.json(); pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.eql(200)); pm.test('code 00',()=>pm.expect(b.responseCode).to.eql('00')); pm.expect(b.responseData.status).to.eql('picked_up');"]}}], "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{donor_token}}"}],"body":{"mode":"raw","raw":"{\"claim_code\":\"{{claim_code}}\"}"},"url":"{{claim_base_url}}/api/v1/claims/{{claim_id}}/verify-pickup"} },
    { "name": "11. Request is completed", "event": [{"listen":"test","script":{"exec":["const b=pm.response.json(); pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.eql(200)); pm.test('code 00',()=>pm.expect(b.rc).to.eql('00')); pm.expect(b.data.status).to.eql('completed');"]}}], "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{recipient_token}}"}],"url":"{{request_base_url}}/api/v1/food-requests/{{request_id}}"} },
    { "name":"Negative tests (optional)", "item":[
      {"name":"Invalid token","event":[{"listen":"test","script":{"exec":["pm.test('HTTP 401',()=>pm.expect(pm.response.code).to.eql(401));"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer invalid-token"}],"url":"{{request_base_url}}/api/v1/food-requests/{{request_id}}"}},
      {"name":"Recipient cannot create listing","event":[{"listen":"test","script":{"exec":["pm.test('HTTP 403 or 500',()=>pm.expect([403,500]).to.include(pm.response.code));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{recipient_token}}"}],"body":{"mode":"raw","raw":"{\"title\":\"not allowed\",\"latitude\":-6.2,\"longitude\":106.8,\"food_type\":\"cooked_food\",\"quantity\":1,\"available_from\":\"{{available_from}}\",\"available_until\":\"{{available_until}}\"}"},"url":"{{food_base_url}}/api/v1/food-listings"}}
    ]}
  ]
}
