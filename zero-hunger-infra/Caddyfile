# Zero Hunger edge: TLS termination, CORS, and routing to the services.
#
# Local development (default): https://localhost:8443 using Caddy's internal CA.
# The browser will warn about the self-signed certificate - accept it once.
#
# Production: set SITE_ADDRESS to your real domain, delete the `tls internal`
# line so Caddy obtains a public Let's Encrypt certificate, and publish 80/443.
#
# CORS is configured here once for every service. Point CORS_ALLOWED_ORIGIN at
# your frontend's origin.

{$SITE_ADDRESS:localhost} {
	tls internal
	encode gzip

	# ---- CORS: one policy for all services ----
	header {
		Access-Control-Allow-Origin "{$CORS_ALLOWED_ORIGIN:http://localhost:3000}"
		Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Origin, Content-Type, Authorization"
		Access-Control-Allow-Credentials "true"
		Access-Control-Max-Age "600"
	}

	# Answer CORS preflight before any proxying. handle blocks are mutually
	# exclusive and evaluated in order, so this must stay first.
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		respond 204
	}

	# ---- Routing (specific paths first) ----
	@users_food_requests path_regexp ^/api/v1/users/[^/]+/food-requests
	handle @users_food_requests {
		reverse_proxy request-service:8083
	}

	handle /api/v1/food-requests* {
		reverse_proxy request-service:8083
	}
	handle /api/v1/food-listings* {
		reverse_proxy food-service:8082
	}
	handle /api/v1/claims* {
		reverse_proxy claim-service:8084
	}
	handle /api/v1/auth* {
		reverse_proxy user-service:8081
	}
	handle /api/v1/users* {
		reverse_proxy user-service:8081
	}
}
