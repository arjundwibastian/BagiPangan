        "/claims/{claim_id}/verify-pickup": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Verify the claim pickup code and mark the claim as completed",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Claims"
                ],
                "summary": "Verify a pickup code",
                "operationId": "verify-pickup-code",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Claim ID",
                        "name": "claim_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Pickup verification information",
