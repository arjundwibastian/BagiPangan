    "definitions": {
        "domain.ClaimStatus": {
            "type": "string",
            "enum": [
                "waiting_for_pickup",
                "picked_up",
                "cancelled"
            ],
            "x-enum-varnames": [
                "StatusWaitingForPickup",
                "StatusPickedUp",
                "StatusCancelled"
            ]
        },
        "domain.FoodClaim": {
            "type": "object",
            "properties": {
                "claim_code": {
                    "type": "string"
                },
                "claim_id": {
                    "type": "string"
                },
                "claimed_at": {
                    "type": "string"
                },
                "claimed_quantity": {
                    "type": "integer"
                },
                "code_expires_at": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "food_listing_id": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/domain.ClaimStatus"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "dto.CreateClaimRequest": {
            "type": "object",
            "properties": {
                "claimed_quantity": {
                    "type": "integer"
                },
                "food_listing_id": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                }
            }
        },
        "dto.HandlerResponse": {
            "type": "object",
            "properties": {
                "responseCode": {
                    "type": "string"
                },
                "responseData": {},
                "responseMessage": {
                    "type": "string"
                }
            }
        },
        "dto.VerifyPickupRequest": {
            "type": "object",
            "properties": {
                "claim_code": {
                    "type": "string"
                }
            }
        }
