{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Food claim creation, cancellation, and pickup verification API.",
        "title": "Zero Hunger Claim Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8084",
    "basePath": "/api/v1",
    "paths": {
        "/claims": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Claim food from a listing for a specific food request",
