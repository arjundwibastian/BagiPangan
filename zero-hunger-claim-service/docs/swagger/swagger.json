        "/claims/{claim_id}/cancel": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Cancel a food claim belonging to the authenticated user",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Claims"
                ],
                "summary": "Cancel a claim",
                "operationId": "cancel-claim",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Claim ID",
                        "name": "claim_id",
                        "in": "path",
                        "required": true
                    }
